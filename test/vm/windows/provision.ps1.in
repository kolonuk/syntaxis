# Runs once at first logon of the Windows test VM (from autounattend.xml).
# Installs the OpenSSH server (needs the guest to have internet, so the first
# boot of a new Windows VM uses nat networking), authorises the test key and
# opens the firewall. vmctl.sh fills in @PUBKEY@.
$ErrorActionPreference = 'Continue'
Start-Transcript -Path C:\provision.log -Append

# A test VM should never sleep or lock itself.
powercfg /change standby-timeout-ac 0
powercfg /change monitor-timeout-ac 0

function Test-Sshd { [bool](Get-Service sshd -ErrorAction SilentlyContinue) }

# 1. Microsoft's Win32-OpenSSH release from GitHub. Quick and reliable.
if (-not (Test-Sshd)) {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $zip = Join-Path $env:TEMP 'OpenSSH-Win64.zip'
    try {
        Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/PowerShell/Win32-OpenSSH/releases/latest/download/OpenSSH-Win64.zip' -OutFile $zip
        Expand-Archive -Path $zip -DestinationPath 'C:\Program Files' -Force
        & 'C:\Program Files\OpenSSH-Win64\install-sshd.ps1'
    } catch { Write-Output "GitHub OpenSSH install failed: $_" }
}

# 2. Fallback: the Windows optional feature. It comes from Windows Update, which
#    can hang on a fresh install, so it gets a time limit.
if (-not (Test-Sshd)) {
    $job = Start-Job { Add-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0' }
    if (-not (Wait-Job $job -Timeout 480)) {
        Write-Output 'OpenSSH capability install timed out'
        Stop-Job $job
    }
    Remove-Job $job -Force -ErrorAction SilentlyContinue
}

Set-Service -Name sshd -StartupType Automatic
Start-Service sshd

New-Item -Force -ItemType Directory -Path C:\ProgramData\ssh | Out-Null
Set-Content -Path C:\ProgramData\ssh\administrators_authorized_keys -Value '@PUBKEY@' -Encoding ascii
icacls.exe C:\ProgramData\ssh\administrators_authorized_keys /inheritance:r /grant 'SYSTEM:F' /grant 'Administrators:F'

if (-not (Get-NetFirewallRule -Name 'sshd-test' -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name 'sshd-test' -DisplayName 'OpenSSH for test VM' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null
}

New-ItemProperty -Path 'HKLM:\SOFTWARE\OpenSSH' -Name DefaultShell -Value 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe' -PropertyType String -Force | Out-Null

Stop-Transcript

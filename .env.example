# Syntaxis configuration. Copy to .env and edit. Never commit .env.
# All values below are neutral placeholders.

# Listen addresses. Admin UI/API is on its own listener; keep it on loopback/LAN/VPN.
SYNTAXIS_LISTEN=0.0.0.0:8080
SYNTAXIS_ADMIN_LISTEN=127.0.0.1:8081
# Public URL used in emails (invite / reset links).
SYNTAXIS_BASE_URL=https://syntaxis.example.com

# Data directory (SQLite DB, audit log). Keep the master key OUTSIDE this directory.
SYNTAXIS_DATA_DIR=/data
# 32-byte key, base64 (generate: `syntaxis keygen`). Or point to a mounted file.
SYNTAXIS_MASTER_KEY=
SYNTAXIS_MASTER_KEY_FILE=

# First admin (created on first boot if no admin exists). Prefer `syntaxis admin create`.
SYNTAXIS_BOOTSTRAP_ADMIN_EMAIL=
SYNTAXIS_BOOTSTRAP_ADMIN_PASSWORD=

# Logging
SYNTAXIS_LOG_LEVEL=info
SYNTAXIS_LOG_FORMAT=json

# Email. Leave SMTP_HOST empty for dev mode (emails are printed to the log).
SYNTAXIS_SMTP_HOST=
SYNTAXIS_SMTP_PORT=587
SYNTAXIS_SMTP_USER=
SYNTAXIS_SMTP_PASSWORD=
SYNTAXIS_SMTP_FROM=syntaxis@example.com

# Docker / sandbox
SYNTAXIS_DOCKER_HOST=tcp://docker-socket-proxy:2375
SYNTAXIS_SANDBOX_RUNTIME=runsc
SYNTAXIS_SANDBOX_IMAGE=syntaxis-sandbox:latest
SYNTAXIS_SANDBOX_NETWORK=syntaxis-sandbox

# Egress policy: open | allowlist | none
SYNTAXIS_EGRESS_MODE=open
SYNTAXIS_EGRESS_ALLOWLIST=
# CIDRs sandboxes must never reach, e.g. your LLM server (comma-separated)
SYNTAXIS_EGRESS_BLOCK=
# Sandbox DNS resolver (policy + logging). Default: <sandbox network gateway>:53
SYNTAXIS_DNS_LISTEN=
SYNTAXIS_DNS_UPSTREAM=
# Used by sandboxes only if the resolver above cannot start
SYNTAXIS_DNS_FALLBACK=1.1.1.1

# Privacy: may admins read message content? Default false.
SYNTAXIS_ALLOW_ADMIN_READ_CONTENT=false

# Optional trusted reverse-proxy header auth (off by default).
SYNTAXIS_PROXY_AUTH_ENABLED=false
SYNTAXIS_PROXY_AUTH_HEADER=X-Forwarded-User
SYNTAXIS_PROXY_TRUSTED=

# Web push (VAPID). Generate with `syntaxis keygen --vapid`.
SYNTAXIS_VAPID_PUBLIC=
SYNTAXIS_VAPID_PRIVATE=

# Published ports for docker compose (host side)
SYNTAXIS_CHAT_BIND=0.0.0.0
SYNTAXIS_CHAT_PORT=8080
SYNTAXIS_ADMIN_BIND=127.0.0.1
SYNTAXIS_ADMIN_PORT=8081

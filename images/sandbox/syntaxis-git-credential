#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# git credential helper for the sandbox: hands git the user's own token for the host it asks about,
# and only for that host. The tokens come from the user's connections (GITHUB_TOKEN, GITLAB_TOKEN with
# GITLAB_HOST, GITEA_TOKEN with GITEA_URL), which Syntaxis puts in the environment of each command.
[ "${1:-}" = get ] || exit 0
host=""
while IFS='=' read -r k v; do
  case "$k" in host) host=$v ;; esac
done
host_of() { printf '%s' "$1" | sed -e 's#^[A-Za-z]*://##' -e 's#/.*##'; }
[ -n "$host" ] || exit 0
if [ "$host" = github.com ] && [ -n "${GITHUB_TOKEN:-}" ]; then
  printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN"
elif [ -n "${GITLAB_TOKEN:-}" ] && [ "$host" = "$(host_of "${GITLAB_HOST:-https://gitlab.com}")" ]; then
  printf 'username=oauth2\npassword=%s\n' "$GITLAB_TOKEN"
elif [ -n "${GITEA_TOKEN:-}" ] && [ -n "${GITEA_URL:-}" ] && [ "$host" = "$(host_of "$GITEA_URL")" ]; then
  printf 'username=token\npassword=%s\n' "$GITEA_TOKEN"
fi
exit 0
